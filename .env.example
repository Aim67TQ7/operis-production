# Copy this file to `.env` and fill in your own values.
# `.env` is gitignored — never commit real credentials.

# --- Required: your Supabase project -----------------------------------------
VITE_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="YOUR-ANON-PUBLISHABLE-KEY"

# --- Branding ----------------------------------------------------------------
VITE_APP_NAME="Ops Daily"
VITE_ORG_NAME="Your Company"
VITE_APP_DESCRIPTION="Operations tracking dashboard"
VITE_LOGO_URL="/logo.svg"
VITE_THEME_COLOR="#1a1a2e"

# --- Optional ----------------------------------------------------------------
# Share a session across subdomains, e.g. ".example.com". Blank = localStorage.
VITE_AUTH_COOKIE_DOMAIN=""

# Table backing the example dashboard view.
VITE_DATA_TABLE="records"

# Fallback connector definitions when the `connections` table is unavailable.
# VITE_CONNECTORS_JSON='[{"id":"erp","systemType":"rest","displayName":"My ERP","baseUrl":"https://erp.example.com/api","isActive":true}]'
